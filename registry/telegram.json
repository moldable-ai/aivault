{
  "$schema": "./schemas/registry-provider.schema.json",
  "provider": "telegram",
  "vaultSecrets": {
    "TELEGRAM_BOT_TOKEN": "secret"
  },
  "auth": {
    "path": {
      "prefix_template": "/bot{{secret}}"
    }
  },
  "hosts": [
    "api.telegram.org"
  ],
  "capabilities": [
    {
      "id": "telegram/delete-message",
      "provider": "telegram",
      "allow": {
        "hosts": [
          "api.telegram.org"
        ],
        "methods": [
          "POST"
        ],
        "pathPrefixes": [
          "/deleteMessage"
        ]
      }
    },
    {
      "id": "telegram/edit-message-text",
      "provider": "telegram",
      "allow": {
        "hosts": [
          "api.telegram.org"
        ],
        "methods": [
          "POST"
        ],
        "pathPrefixes": [
          "/editMessageText"
        ]
      }
    },
    {
      "id": "telegram/get-me",
      "provider": "telegram",
      "allow": {
        "hosts": [
          "api.telegram.org"
        ],
        "methods": [
          "POST"
        ],
        "pathPrefixes": [
          "/getMe"
        ]
      }
    },
    {
      "id": "telegram/get-updates",
      "provider": "telegram",
      "allow": {
        "hosts": [
          "api.telegram.org"
        ],
        "methods": [
          "POST"
        ],
        "pathPrefixes": [
          "/getUpdates"
        ]
      }
    },
    {
      "id": "telegram/send-chat-action",
      "provider": "telegram",
      "allow": {
        "hosts": [
          "api.telegram.org"
        ],
        "methods": [
          "POST"
        ],
        "pathPrefixes": [
          "/sendChatAction"
        ]
      }
    },
    {
      "id": "telegram/send-message",
      "provider": "telegram",
      "allow": {
        "hosts": [
          "api.telegram.org"
        ],
        "methods": [
          "POST"
        ],
        "pathPrefixes": [
          "/sendMessage"
        ]
      }
    }
  ]
}
